{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webblancoynegronuevo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "FOTOS_BUCKET",
      "bucket_name": "blancoynegro-fotos"
    }
  ]
}
